package-as: TalentShare

# the player-facing notes are the release text on GitHub (and CurseForge once the upload is automated)
manual-changelog:
  filename: RELEASE_NOTES.md
  markup-type: markdown

ignore:
  - tests
  - dev
  - eval
  - docs
  - tools
  - dist
  - screens-debug
  - icon.png
  - review
  - features
  - TalentShare-Dev.toc
  - .claude
  - .github
  - .gitignore
  - .pkgmeta
