#!/bin/sh
# Last line of defence (commits made with --no-verify or elsewhere): blocks a push when an outgoing commit's
# author/committer email, message or added lines match .git/info/forbidden-words.
. "$(dirname "$0")/_forbidden.sh"
forbidden_patterns || exit 0
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue
    if [ "$remote_sha" = "$zero" ]; then range="$local_sha --not --remotes"; else range="$remote_sha..$local_sha"; fi
    for commit in $(git rev-list $range); do
        hits=$( { git log -1 --format='<%ae>%n<%ce>' "$commit" | email_only
                  git log -1 --format='%B' "$commit"
                  git show --format= -U0 --no-color --no-ext-diff "$commit" | grep -E '^(\+|diff --git )' | grep -v '^+++ '
                } | forbidden_matches)
        if [ -n "$hits" ]; then
            echo "pre-push: commit $(git log -1 --format='%h %s' "$commit") contains forbidden words:" >&2
            echo "$hits" | cut -c1-200 >&2
            status=1
        fi
    done
done
exit $status
