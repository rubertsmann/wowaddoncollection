#!/bin/sh
# Blocks a commit whose added lines, file names or author/committer email match .git/info/forbidden-words.
. "$(dirname "$0")/_forbidden.sh"
forbidden_patterns || exit 0
status=0
hits=$(git diff --cached -U0 --no-color --no-ext-diff | grep -E '^(\+|diff --git )' | grep -v '^+++ ' | forbidden_matches)
if [ -n "$hits" ]; then
    echo "pre-commit: staged changes contain forbidden words (identity leak):" >&2
    echo "$hits" | cut -c1-200 >&2
    status=1
fi
for who in GIT_AUTHOR_IDENT GIT_COMMITTER_IDENT; do
    if git var "$who" | email_only | forbidden_matches > /dev/null; then
        echo "pre-commit: $who uses a private email; set: git config user.email <id>+<login>@users.noreply.github.com" >&2
        status=1
    fi
done
[ $status -eq 0 ] || echo "Fix the lines above (or edit .git/info/forbidden-words for a false positive)." >&2
exit $status
